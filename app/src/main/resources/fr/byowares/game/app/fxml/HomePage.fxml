<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane alignment="TOP_LEFT" minHeight="600.0" minWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.byowares.game.app.HomePageController">
    <children>
        <VBox stylesheets="@../css/homepage.css">
            <children>
                <MenuBar VBox.vgrow="NEVER">
                    <menus>
                        <Menu fx:id="options" mnemonicParsing="false" onAction="#openOptions" />
                        <Menu fx:id="about" mnemonicParsing="false" onAction="#openAbout" />
                    </menus>
                </MenuBar>
                <HBox maxHeight="-Infinity" minHeight="-Infinity" prefHeight="15.0" />
                <HBox alignment="CENTER">
                    <children>
                        <ComboBox fx:id="language" prefWidth="85.0" />
                        <HBox prefHeight="53.0" prefWidth="30.0" />
                        <ToggleButton fx:id="darkTheme" mnemonicParsing="false" />
                        <ToggleButton fx:id="lightTheme" layoutX="354.0" layoutY="19.0" mnemonicParsing="false" />
                    </children>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </HBox>
                <HBox spacing="20.0">
                    <children>
                        <Button fx:id="miqButton" contentDisplay="CENTER" graphicTextGap="0.0" mnemonicParsing="false" prefHeight="250.0" prefWidth="250.0" styleClass="game-button" textAlignment="CENTER" />
                        <VBox>
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Title" />
                                <Text layoutX="10.0" layoutY="23.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Bla bla bla bla" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
                    </padding>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </HBox>
                <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </children>
</StackPane>
