<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<HBox alignment="CENTER" spacing="25.0" stylesheets="@../css/GameAccess.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.byowares.game.app.fxml.GameAccess">
    <children>
        <Button fx:id="gameButton" contentDisplay="CENTER" graphicTextGap="0.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="250.0" prefWidth="250.0" textAlignment="CENTER">
            <styleClass>
                <String fx:value="game-button" />
                <String fx:value="flat" />
            <String fx:value="font-icon" />
            </styleClass>
        </Button>
        <VBox spacing="25.0">
            <children>
                <Text fx:id="gameTitle" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: BareCast; -fx-font-size: 4em; -fx-font-weight: bolder;" styleClass="game-title" text="Dummy title" />
                <Text fx:id="gameDescription" layoutX="10.0" layoutY="23.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Dummy presentation">
               <styleClass>
                  <String fx:value="title-4" />
                  <String fx:value="game-desc" />
               </styleClass></Text>
            </children>
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
         <HBox.margin>
            <Insets top="50.0" />
         </HBox.margin>
        </VBox>
    </children>
    <opaqueInsets>
        <Insets />
    </opaqueInsets>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</HBox>
