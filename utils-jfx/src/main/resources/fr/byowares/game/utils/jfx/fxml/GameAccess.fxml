<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<HBox alignment="CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Button fx:id="icon" contentDisplay="CENTER" graphicTextGap="0.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onAction" prefHeight="250.0" prefWidth="250.0" style="-fx-shape: &quot;M 100 250 L 200 200 L 300 250 L 300 350 L 200 400 L 100 350 L 100 250&quot;;" textAlignment="CENTER">
            <styleClass>
                <String fx:value="flat" />
                <String fx:value="font-icon" />
                <String fx:value="game-button" />
            </styleClass>
        </Button>
        <VBox spacing="25.0">
            <children>
                <Text fx:id="title" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: BareCast; -fx-font-size: 4em; -fx-font-weight: bolder;" text="Dummy title" />
                <Text fx:id="desc" layoutX="10.0" layoutY="23.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-family: monospace;" styleClass="title-4" text="Dummy presentation" />
            </children>
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
            <HBox.margin>
                <Insets top="50.0" />
            </HBox.margin>
        </VBox>
    </children>
    <opaqueInsets>
        <Insets />
    </opaqueInsets>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</HBox>
