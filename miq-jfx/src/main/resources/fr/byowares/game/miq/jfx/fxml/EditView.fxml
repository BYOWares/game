<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>


<BorderPane maxHeight="1.7976931348623157E308" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <left>
      <VBox>
         <children>
            <HBox alignment="BASELINE_CENTER" spacing="2.0">
               <children>
                  <Button fx:id="bEdit" layoutX="183.0" layoutY="12.0" mnemonicParsing="false" onAction="#onEdit" styleClass="flat" text="edit" />
                  <Button fx:id="bAdd" mnemonicParsing="false" onAction="#onAdd" styleClass="flat" text="add" />
                  <Button fx:id="bDelete" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onDelete" styleClass="flat" text="delete" />
                  <Button fx:id="bSelectCurrent" layoutX="51.0" layoutY="12.0" mnemonicParsing="false" onAction="#onSelectCurrent" styleClass="flat" text="select" />
                  <Button fx:id="bExpandAll" layoutX="86.0" layoutY="12.0" mnemonicParsing="false" onAction="#onExpandAll" styleClass="flat" text="expand" />
                  <Button fx:id="bCollapseAll" layoutX="119.0" layoutY="12.0" mnemonicParsing="false" onAction="#onCollapseAll" styleClass="flat" text="collapse" />
               </children>
               <padding>
                  <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
               </padding>
               <VBox.margin>
                  <Insets left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </HBox>
            <TreeView fx:id="tree" prefWidth="600.0">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </TreeView>
         </children>
      </VBox>
   </left>
   <center>
      <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER" />
   </center>
   <top>
      <HBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="bBack" mnemonicParsing="false" onAction="#onBack" styleClass="flat" text="Dummy text" />
            <Text fx:id="title" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 4em; -fx-font-family: BareCast; -fx-font-weight: bold;" text="MIQ Editor" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </top>
</BorderPane>
